# Comma-separated API keys for provider pool and failover (at least 2 recommended)
LLM_API_KEYS=key_1,key_2

# Primary model identifier for LiteLLM (e.g. gemini/gemini-2.0-flash, groq/llama-3.3-70b-versatile)
LLM_MODEL=gemini/gemini-2.0-flash

# Optional comma-separated fallback models tried in order if all keys fail on primary model (default empty)
LLM_FALLBACK_MODELS=

# Built-in in-memory LLM cache toggle (true / false)
CACHE_ENABLED=true

# Allow simulating provider failures per request via X-Simulate-Failure header (true / false)
ENABLE_FAILURE_SIMULATION=false

# Allowed CORS origins, comma-separated
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite database file path / connection URL
DATABASE_URL=sqlite:////data/app.db

# In-memory sliding window rate limit per client IP for POST /chat only (default: 120, 0 disables)
RATE_LIMIT_PER_MINUTE=120

# Maximum accepted request body size in bytes (default: 65536)
MAX_BODY_BYTES=65536
